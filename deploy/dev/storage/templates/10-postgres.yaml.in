# The runtime Secret postgres-runtime must exist; credentials are not in this file.
apiVersion: v1
kind: Service
metadata:
  name: postgres-headless
  namespace: ${NAMESPACE}
spec:
  clusterIP: None
  selector:
    app.kubernetes.io/name: orca-dev-postgres
  ports:
  - name: postgres
    port: 5432
    targetPort: postgres
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: ${NAMESPACE}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: orca-dev-postgres
  ports:
  - name: postgres
    port: 5432
    targetPort: postgres
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: postgres
  namespace: ${NAMESPACE}
  labels:
    orca.dev/dataset: ${DATASET}
spec:
  serviceName: postgres-headless
  replicas: 1
  persistentVolumeClaimRetentionPolicy:
    whenDeleted: Retain
    whenScaled: Retain
  selector:
    matchLabels:
      app.kubernetes.io/name: orca-dev-postgres
  template:
    metadata:
      labels:
        app.kubernetes.io/name: orca-dev-postgres
        orca.dev/dataset: ${DATASET}
    spec:
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 25
      nodeSelector:
        cloud.google.com/gke-spot: "true"
        kubernetes.io/arch: amd64
      tolerations:
      - key: cloud.google.com/gke-spot
        operator: Equal
        value: "true"
        effect: NoSchedule
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
        runAsGroup: 999
        fsGroup: 999
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile:
          type: RuntimeDefault
      containers:
      - name: postgres
        image: docker.io/library/postgres@sha256:1a6ab3f5345eb6dbe04a1349529caabdb0ab09293a09590fad07b2246bfa4b54
        imagePullPolicy: IfNotPresent
        args:
        - -c
        - max_connections=50
        - -c
        - shared_buffers=128MB
        - -c
        - fsync=on
        - -c
        - synchronous_commit=on
        - -c
        - full_page_writes=on
        env:
        - name: PGDATA
          value: /var/lib/postgresql/data/pgdata
        - name: POSTGRES_DB
          value: orca_dev
        - name: POSTGRES_USER
          value: postgres
        - name: POSTGRES_PASSWORD_FILE
          value: /run/postgres-runtime/superuser-password
        ports:
        - name: postgres
          containerPort: 5432
        resources:
          requests:
            cpu: 250m
            memory: 512Mi
            ephemeral-storage: 512Mi
          limits:
            memory: 512Mi
            ephemeral-storage: 512Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop: [ALL]
        volumeMounts:
        - name: data
          mountPath: /var/lib/postgresql/data
        - name: runtime-secret
          mountPath: /run/postgres-runtime
          readOnly: true
        startupProbe:
          exec:
            command: [pg_isready, -U, postgres, -d, orca_dev, -h, 127.0.0.1]
          periodSeconds: 5
          timeoutSeconds: 3
          failureThreshold: 60
        readinessProbe:
          exec:
            command: [pg_isready, -U, postgres, -d, orca_dev, -h, 127.0.0.1]
          periodSeconds: 10
          timeoutSeconds: 3
        livenessProbe:
          exec:
            command: [pg_isready, -U, postgres, -d, orca_dev, -h, 127.0.0.1]
          periodSeconds: 20
          timeoutSeconds: 3
          failureThreshold: 6
      volumes:
      - name: runtime-secret
        secret:
          secretName: postgres-runtime
          defaultMode: 0440
  volumeClaimTemplates:
  - metadata:
      name: data
      labels:
        orca.dev/dataset: ${DATASET}
    spec:
      accessModes: [ReadWriteOnce]
      volumeMode: Filesystem
      storageClassName: ${PG_STORAGE_CLASS}
      resources:
        requests:
          storage: 10Gi
