# NFS placement is on-demand; PG requires Spot.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: nfs-ssd-data
  namespace: ${NAMESPACE}
  labels:
    orca.dev/dataset: ${DATASET}
spec:
  accessModes: [ReadWriteOnce]
  volumeMode: Filesystem
  storageClassName: ${NFS_STORAGE_CLASS}
  resources:
    requests:
      storage: 50Gi
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: nfs-exports
  namespace: ${NAMESPACE}
data:
  exports: |
    /x (rw,no_root_squash,insecure)
---
apiVersion: v1
kind: Service
metadata:
  name: nfs
  namespace: ${NAMESPACE}
  labels:
    orca.dev/dataset: ${DATASET}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: orca-dev-nfs
  ports:
  - name: nfs
    port: 2049
    targetPort: nfs
    protocol: TCP
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nfs
  namespace: ${NAMESPACE}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: orca-dev-nfs
  template:
    metadata:
      labels:
        app.kubernetes.io/name: orca-dev-nfs
        orca.dev/dataset: ${DATASET}
    spec:
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 30
      nodeSelector:
        kubernetes.io/arch: amd64
      containers:
      - name: unfs3
        image: ${UNFS_IMAGE}
        imagePullPolicy: IfNotPresent
        command: [/bin/sh, -ec]
        args:
        - |
          mkdir -p /exports/x/agents /exports/x/dev /exports/x/test-homes
          chown 1000:1000 /exports/x /exports/x/agents /exports/x/dev /exports/x/test-homes
          chmod 0755 /exports/x /exports/x/agents /exports/x/dev /exports/x/test-homes
          exec unfsd -d -p -t -n 2049 -m 2049 -e /etc/exports
        ports:
        - name: nfs
          containerPort: 2049
          protocol: TCP
        resources:
          requests:
            cpu: 250m
            memory: 512Mi
            ephemeral-storage: 256Mi
          limits:
            memory: 512Mi
            ephemeral-storage: 256Mi
        securityContext:
          capabilities:
            add: [NET_BIND_SERVICE, CHOWN, DAC_OVERRIDE, FOWNER, FSETID, SETUID, SETGID, MKNOD]
        volumeMounts:
        - name: data
          mountPath: /exports
        - name: data
          mountPath: /x
          subPath: x
        - name: exports
          mountPath: /etc/exports
          subPath: exports
          readOnly: true
        readinessProbe:
          tcpSocket:
            port: nfs
          periodSeconds: 5
        livenessProbe:
          tcpSocket:
            port: nfs
          periodSeconds: 10
          failureThreshold: 6
      volumes:
      - name: data
        persistentVolumeClaim:
          claimName: nfs-ssd-data
      - name: exports
        configMap:
          name: nfs-exports
