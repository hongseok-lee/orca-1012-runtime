# NFS placement is on-demand; PG requires Spot.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: nfs-ssd-data
  namespace: ${NAMESPACE}
  labels:
    orca.dev/dataset: ${DATASET}
spec:
  accessModes: [ReadWriteOnce]
  volumeMode: Filesystem
  storageClassName: ${NFS_STORAGE_CLASS}
  resources:
    requests:
      storage: 50Gi
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: nfs-exports
  namespace: ${NAMESPACE}
data:
  exports: |
    /x (rw,no_root_squash,insecure)
    /exports/runtime-domains (rw,root_squash,insecure)
    /exports/shared/${DATASET} (rw,root_squash,insecure)
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: ${MANAGED_STORAGE_CONFIGMAP}
  namespace: ${NAMESPACE}
  labels:
    orca.dev/dataset: ${DATASET}
immutable: true
binaryData:
  managed_storage.sh: "${MANAGED_STORAGE_BASE64}"
---
apiVersion: v1
kind: Service
metadata:
  name: nfs
  namespace: ${NAMESPACE}
  labels:
    orca.dev/dataset: ${DATASET}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: orca-dev-nfs
  ports:
  - name: nfs
    port: 2049
    targetPort: nfs
    protocol: TCP
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nfs
  namespace: ${NAMESPACE}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: orca-dev-nfs
  template:
    metadata:
      annotations:
        orca.dev/exports-sha256: "${NFS_EXPORTS_SHA256}"
        orca.dev/managed-storage-sha256: "${MANAGED_STORAGE_SHA256}"
      labels:
        app.kubernetes.io/name: orca-dev-nfs
        orca.dev/dataset: ${DATASET}
    spec:
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 30
      nodeSelector:
        kubernetes.io/arch: amd64
      initContainers:
      - name: nfs-storage-bootstrap
        image: ${UNFS_IMAGE}
        imagePullPolicy: IfNotPresent
        command: [/bin/sh, /opt/orca-nfs-tools/managed_storage.sh]
        args: [bootstrap, "${DATASET}"]
        env:
        - name: ORCA_NFS_POD_UID
          valueFrom:
            fieldRef:
              fieldPath: metadata.uid
        resources:
          requests:
            cpu: 250m
            memory: 512Mi
            ephemeral-storage: 256Mi
          limits:
            memory: 512Mi
            ephemeral-storage: 256Mi
        securityContext:
          runAsUser: 0
          runAsGroup: 0
          allowPrivilegeEscalation: false
          capabilities:
            drop: [ALL]
            add: [CHOWN, FOWNER]
        volumeMounts:
        - name: data
          mountPath: /exports
        - name: managed-storage-tools
          mountPath: /opt/orca-nfs-tools
          readOnly: true
      containers:
      - name: unfs3
        image: ${UNFS_IMAGE}
        imagePullPolicy: IfNotPresent
        command: [/bin/sh, -ec]
        args:
        - |
          /bin/sh /opt/orca-nfs-tools/managed_storage.sh bootstrap '${DATASET}'
          exec unfsd -d -p -t -n 2049 -m 2049 -e /etc/exports
        env:
        - name: ORCA_NFS_POD_UID
          valueFrom:
            fieldRef:
              fieldPath: metadata.uid
        ports:
        - name: nfs
          containerPort: 2049
          protocol: TCP
        resources:
          requests:
            cpu: 250m
            memory: 512Mi
            ephemeral-storage: 256Mi
          limits:
            memory: 512Mi
            ephemeral-storage: 256Mi
        securityContext:
          capabilities:
            add: [NET_BIND_SERVICE, CHOWN, DAC_OVERRIDE, FOWNER, FSETID, SETUID, SETGID, MKNOD]
        volumeMounts:
        - name: data
          mountPath: /exports
        - name: data
          mountPath: /x
          subPath: x
        - name: exports
          mountPath: /etc/exports
          subPath: exports
          readOnly: true
        - name: managed-storage-tools
          mountPath: /opt/orca-nfs-tools
          readOnly: true
        readinessProbe:
          tcpSocket:
            port: nfs
          periodSeconds: 5
        livenessProbe:
          tcpSocket:
            port: nfs
          periodSeconds: 10
          failureThreshold: 6
      volumes:
      - name: data
        persistentVolumeClaim:
          claimName: nfs-ssd-data
      - name: exports
        configMap:
          name: nfs-exports
      - name: managed-storage-tools
        configMap:
          name: ${MANAGED_STORAGE_CONFIGMAP}
          defaultMode: 0444
