apiVersion: v1
kind: Namespace
metadata:
  name: ${NAMESPACE}
  labels:
    orca.dev/dataset: ${DATASET}
---
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: ${PG_STORAGE_CLASS}
provisioner: pd.csi.storage.gke.io
parameters:
  type: pd-balanced
  csi.storage.k8s.io/fstype: ext4
reclaimPolicy: Retain
volumeBindingMode: WaitForFirstConsumer
allowVolumeExpansion: true
---
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: ${NFS_STORAGE_CLASS}
provisioner: pd.csi.storage.gke.io
parameters:
  type: pd-ssd
  csi.storage.k8s.io/fstype: ext4
reclaimPolicy: Retain
volumeBindingMode: WaitForFirstConsumer
allowVolumeExpansion: true
