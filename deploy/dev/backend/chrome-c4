#!/bin/sh
set -eu
# Keep the existing approval/argv guard in a child. Node process.execve closes
# inherited FDs above stderr; Chromium's CDP pipes must survive this parent exec.
/usr/local/bin/node /home/orca-dev/.local/share/orca-1012-browser/chrome-c4-guard.cjs "$@" < /dev/null
export LD_LIBRARY_PATH=/home/orca-dev/.local/share/orca-1012-browser/bookworm-libs/payload/usr/lib/x86_64-linux-gnu:/home/orca-dev/.local/share/orca-1012-browser/bookworm-libs/payload/lib/x86_64-linux-gnu
for arg in "$@"; do
  if [ "$arg" = --no-sandbox ]; then
    exec /home/orca-dev/.local/share/orca-1012-browser/chromium-1217/chrome-linux64/chrome "$@"
  fi
done
exec /home/orca-dev/.local/share/orca-1012-browser/chromium-1217/chrome-linux64/chrome --no-sandbox "$@"
