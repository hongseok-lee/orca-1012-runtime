{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "../src/main/durable-runtime/db/**/*.ts",
    "../src/main/durable-runtime/db/**/*.mts",
    "../src/shared/durable-runtime/identity.ts",
    "../src/main/durable-runtime/journal/**/*.ts",
    "../src/main/durable-runtime/journal/**/*.mts"
  ]
}
