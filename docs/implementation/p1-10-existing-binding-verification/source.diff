+  identity_verified_at: Date | null; seal_id: string | null
+}>('SELECT * FROM durable_runtime.storage_bindings WHERE id=$1', [id])).rows[0]
+async function history(id: StorageBindingId) {
+  return (await pool.query<{ journal: string; audit: string; outbox: string }>(`SELECT
+    (SELECT count(*)::text FROM durable_runtime.session_events WHERE body->>'bindingId'=$1) AS journal,
+    (SELECT count(*)::text FROM durable_runtime.runtime_audit_events WHERE next_state->>'bindingId'=$1) AS audit,
+    (SELECT count(*)::text FROM durable_runtime.outbox_events WHERE aggregate_id=$1::uuid) AS outbox`, [id])).rows[0]
+}
