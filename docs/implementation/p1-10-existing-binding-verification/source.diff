+import assert from 'node:assert/strict'
+import { createHash, randomUUID } from 'node:crypto'
+import { test } from 'node:test'
+import { setTimeout as pause } from 'node:timers/promises'
+import { createDurablePool, DurableDatabaseError, withDurableTransaction } from '../db/connection.ts'
+import type { DurableTransaction } from '../db/connection.ts'
+import { readMigrations } from '../db/migrate.ts'
+import { counter, logicalId } from '../../../shared/durable-runtime/identity.ts'
+import type { StorageBindingId } from '../../../shared/durable-runtime/identity.ts'
+import { StorageStore } from './store.ts'
+import type { Binding, StorageScope } from './store.ts'
+import type { BindingVerificationInput } from './binding-verification.ts'
+import type { CanonicalCandidate } from './canonical.ts'
+import type { StorageEvidenceAuthority, VerifiedDirectoryEvidence, VerifiedMountEvidence,
+  VerifiedPermanentComputeStop, ExecutionTarget } from './evidence.ts'
+
+// Root supplies exact existing isolated DB/system/OID and immutable SQL001–021
+// inputs at execution dispatch. No database selection, schema apply or reset.
+const database = process.env.ORCA_BINDING_VERIFICATION_DATABASE
+const oid = process.env.ORCA_BINDING_VERIFICATION_DATABASE_OID
+const system = process.env.ORCA_BINDING_VERIFICATION_SYSTEM
+const migrationsPath = process.env.ORCA_BINDING_VERIFICATION_MIGRATIONS
+if (process.env.ORCA_BINDING_VERIFICATION_APPROVED !== 'root-first-verification' ||
+    !database || !/^orca_[a-z0-9_]+$/.test(database) || database === 'orca_dev' ||
+    database !== process.env.PGDATABASE || !oid || !/^[1-9][0-9]*$/.test(oid) ||
+    !system || !/^[1-9][0-9]*$/.test(system) || !migrationsPath) {
+  throw new Error('Root-approved existing isolated DB/system/OID and migrations required')
+}
+const pool = createDurablePool({ database, max: 6, application_name: 'existing-binding-verification-first' })
+const hash = (text: string) => createHash('sha256').update(text).digest('hex')
+const rejectCode = (promise: Promise<unknown>, code: string) => assert.rejects(promise,
+  error => error instanceof DurableDatabaseError && error.code === code)
+const rowTables = ['agents', 'workspaces', 'sessions', 'tabs', 'runtime_units', 'runtime_members',
+  'runtime_member_storage_bindings', 'storage_domains', 'storage_bindings', 'resource_profiles',
+  'attempts', 'storage_write_grants', 'storage_mounts', 'snapshot_manifests', 'storage_seals',
+  'session_events', 'runtime_audit_events', 'outbox_events'] as const
+async function rowHashes() {
+  const result: Record<string, string[]> = {}
+  for (const table of rowTables) {
+    result[table] = (await pool.query<{ body: string }>(
+      `SELECT to_jsonb(t)::text AS body FROM durable_runtime.${table} t`)).rows.map(row => hash(row.body)).sort()
+  }
+  return result
+}
+function retained(before: Record<string, string[]>, after: Record<string, string[]>) {
+  for (const table of rowTables) {
+    const remaining = new Map<string, number>()
+    for (const value of after[table]) { remaining.set(value, (remaining.get(value) ?? 0) + 1) }
+    for (const value of before[table]) {
+      assert.ok((remaining.get(value) ?? 0) > 0, `original row missing in ${table}`)
+      remaining.set(value, (remaining.get(value) ?? 0) - 1)
+    }
+  }
+}
+async function identity() {
+  const value = (await pool.query<{ database: string; oid: string; system: string; backend_pid: number }>(
+    `SELECT current_database() AS database,(SELECT oid::text FROM pg_database WHERE datname=current_database()) AS oid,
+      (SELECT system_identifier::text FROM pg_control_system()) AS system,pg_backend_pid() AS backend_pid`)).rows[0]
+  assert.equal(value.database, database); assert.equal(value.oid, oid); assert.equal(value.system, system)
+  assert.deepEqual((await pool.query('SELECT dataset_name FROM durable_runtime.dataset_metadata')).rows,
+    [{ dataset_name: 'orca-1012-dev-v1' }])
+  return value
+}
+
+// Narrow reuse of the reviewed directory fixture. No production verifier/pin,
+// actual filesystem authentication or physical lifetime is qualified here.
+class FixtureAuthority implements StorageEvidenceAuthority {
+  directories = new Map<string, VerifiedDirectoryEvidence>()
+  invalid = new Set<string>()
+  throws = new Set<string>()
+  directory(reference: string) {
+    if (this.throws.has(reference)) { throw new Error('synthetic accessor failure') }
+    return this.directories.get(reference) ?? null
+  }
+  directoryPinValid(value: VerifiedDirectoryEvidence) {
+    return !this.invalid.has(value.evidenceRef) && this.directories.get(value.evidenceRef) === value
+  }
+  mount(_ref: string): VerifiedMountEvidence | null { return null }
+  mountPinValid(_held: VerifiedMountEvidence) { return false }
+  executionTarget(_attempt: string): ExecutionTarget | null { return null }
+  executionTargetPinValid(_held: ExecutionTarget) { return false }
+  permanentComputeStop(_ref: string): VerifiedPermanentComputeStop | null { return null }
+  computeStopPinValid(_held: VerifiedPermanentComputeStop) { return false }
+  issue(candidate: CanonicalCandidate, options: { mutableEvidence?: boolean; pin?: string; ref?: string } = {}) {
+    const ref = options.ref ?? `synthetic-existing-proof:${randomUUID()}`
+    const value = { evidenceRef: ref, topologyPinId: options.pin ?? `synthetic-pin:${randomUUID()}`, candidate }
+    // SAFETY: only this fixture supplies the branded synthetic evidence; this
+    // cast does not authenticate an observation or issue production authority.
+    const held = (options.mutableEvidence ? value : Object.freeze(value)) as VerifiedDirectoryEvidence
+    this.directories.set(ref, held)
+    return held
+  }
+}
+
+async function blockedBy(waiter: number, blocker: number) {
+  for (let i = 0; i < 100; i++) {
+    if ((await pool.query<{ blocked: boolean }>(
+      'SELECT $1::int=ANY(pg_blocking_pids($2::int)) AS blocked', [blocker, waiter])).rows[0].blocked) { return }
+    await pause(50)
+  }
+  throw new DurableDatabaseError('STORAGE_FIXTURE_LOCK_WAIT_NOT_OBSERVED')
+}
+const backendPid = async (tx: DurableTransaction) =>
+  (await tx.query<{ pid: number }>('SELECT pg_backend_pid() AS pid')).rows[0].pid
