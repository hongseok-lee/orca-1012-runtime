{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "preserveSymlinks": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "paths": {
      "@shared/*": [
        "./source/src/shared/*"
      ],
      "@main/*": [
        "./source/src/main/*"
      ],
      "@renderer/*": [
        "./source/src/renderer/src/*"
      ]
    },
    "types": [
      "node"
    ],
    "typeRoots": [
      "<existing-tools-cache>/node_modules/@types"
    ]
  },
  "files": [
    "./source/src/main/durable-runtime/runtime/agent-pod-plan-records.ts",
    "./source/src/main/durable-runtime/db/agent-pod-plan-record-rows.ts",
    "./source/src/main/durable-runtime/runtime/agent-pod-plan-records.pg.test.mts"
  ]
}
