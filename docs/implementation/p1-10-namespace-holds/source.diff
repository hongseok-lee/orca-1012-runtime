diff --git a/src/main/durable-runtime/db/migrations/022-storage-namespace-holds.sql b/src/main/durable-runtime/db/migrations/022-storage-namespace-holds.sql
new file mode 100644
index 00000000..006d3748
--- /dev/null
+++ b/src/main/durable-runtime/db/migrations/022-storage-namespace-holds.sql
@@ -0,0 +1,170 @@
+SET LOCAL search_path = durable_runtime, pg_catalog;
+
+-- Management namespace coordination only. These rows do not fence file writers
+-- or certify a PV/export/helper/access-policy digest. There is no expiry.
+CREATE TABLE storage_namespace_profiles (
+  id uuid PRIMARY KEY,
+  dataset_name text NOT NULL REFERENCES dataset_metadata,
+  backend_id text NOT NULL,
+  export_id text NOT NULL,
+  generation bigint NOT NULL CHECK (generation >= 0),
+  digest text NOT NULL CHECK (digest ~ '^[0-9a-f]{64}$'),
+  state text NOT NULL CHECK (state IN ('ACTIVE','DRAINING','APPLYING')),
+  management_operation_id uuid,
+  revision bigint NOT NULL DEFAULT 0 CHECK (revision >= 0),
+  UNIQUE (dataset_name,backend_id,export_id),
+  FOREIGN KEY (backend_id,export_id) REFERENCES storage_domains,
+  CHECK ((state='ACTIVE') = (management_operation_id IS NULL))
+);
+CREATE TABLE storage_namespace_profile_versions (
+  profile_id uuid NOT NULL REFERENCES storage_namespace_profiles,
+  generation bigint NOT NULL CHECK (generation >= 0),
+  digest text NOT NULL CHECK (digest ~ '^[0-9a-f]{64}$'),
+  PRIMARY KEY (profile_id,generation),
+  UNIQUE (profile_id,generation,digest)
+);
+ALTER TABLE storage_namespace_profiles ADD FOREIGN KEY (id,generation,digest)
+  REFERENCES storage_namespace_profile_versions(profile_id,generation,digest)
+  DEFERRABLE INITIALLY DEFERRED;
+CREATE TABLE storage_namespace_holds (
+  id uuid PRIMARY KEY,
+  profile_id uuid NOT NULL,
+  generation bigint NOT NULL,
+  digest text NOT NULL,
+  owner_token_hash text NOT NULL CHECK (owner_token_hash ~ '^[0-9a-f]{64}$'),
+  state text NOT NULL CHECK (state IN ('HELD','RELEASED')),
+  created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+  released_at timestamptz,
+  FOREIGN KEY (profile_id,generation,digest)
+    REFERENCES storage_namespace_profile_versions(profile_id,generation,digest),
+  CHECK ((state='RELEASED') = (released_at IS NOT NULL))
+);
+CREATE INDEX storage_namespace_held ON storage_namespace_holds(profile_id) WHERE state='HELD';
+CREATE TABLE storage_namespace_management_operations (
+  id uuid PRIMARY KEY,
+  profile_id uuid NOT NULL,
+  generation bigint NOT NULL,
+  digest text NOT NULL,
+  owner_token_hash text NOT NULL CHECK (owner_token_hash ~ '^[0-9a-f]{64}$'),
+  target_generation bigint NOT NULL CHECK (target_generation > 0),
+  target_digest text NOT NULL CHECK (target_digest ~ '^[0-9a-f]{64}$'),
+  state text NOT NULL CHECK (state IN ('DRAINING','APPLYING','COMPLETED')),
+  created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+  claimed_at timestamptz,
+  completed_at timestamptz,
+  UNIQUE (id,profile_id,generation,digest),
+  FOREIGN KEY (profile_id,generation,digest)
+    REFERENCES storage_namespace_profile_versions(profile_id,generation,digest),
+  CHECK (target_generation=generation+1),
+  CHECK ((state IN ('APPLYING','COMPLETED')) = (claimed_at IS NOT NULL)),
+  CHECK ((state='COMPLETED') = (completed_at IS NOT NULL))
+);
+CREATE UNIQUE INDEX storage_namespace_one_management_operation
+  ON storage_namespace_management_operations(profile_id) WHERE state<>'COMPLETED';
+ALTER TABLE storage_namespace_profiles ADD FOREIGN KEY (management_operation_id,id,generation,digest)
+  REFERENCES storage_namespace_management_operations(id,profile_id,generation,digest)
+  DEFERRABLE INITIALLY DEFERRED;
+
+CREATE FUNCTION guard_namespace_profile() RETURNS trigger LANGUAGE plpgsql
+SET search_path = pg_catalog, durable_runtime, pg_temp AS $$
+DECLARE valid boolean;
+BEGIN
+  IF TG_OP='DELETE' THEN
+    RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Namespace profile history is retained';
+  END IF;
+  IF TG_OP='INSERT' THEN
+    IF NEW.state<>'ACTIVE' OR NEW.revision<>0 THEN
+      RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Namespace profile initial state';
+    END IF;
+    RETURN NEW;
+  END IF;
+  IF ROW(NEW.id,NEW.dataset_name,NEW.backend_id,NEW.export_id)
+       IS DISTINCT FROM ROW(OLD.id,OLD.dataset_name,OLD.backend_id,OLD.export_id)
+       OR NEW.revision<>OLD.revision+1 THEN
+    RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Namespace profile identity/revision';
+  END IF;
+  valid := false;
+  IF OLD.state='ACTIVE' AND NEW.state='DRAINING' AND
+     ROW(NEW.generation,NEW.digest)=ROW(OLD.generation,OLD.digest) THEN
+    SELECT EXISTS(SELECT 1 FROM storage_namespace_management_operations o
+      WHERE o.id=NEW.management_operation_id AND o.profile_id=OLD.id
+      AND o.generation=OLD.generation AND o.digest=OLD.digest AND o.state='DRAINING') INTO valid;
+  ELSIF OLD.state='DRAINING' AND NEW.state='APPLYING' AND
+     ROW(NEW.generation,NEW.digest,NEW.management_operation_id)=
+     ROW(OLD.generation,OLD.digest,OLD.management_operation_id) THEN
+    SELECT EXISTS(SELECT 1 FROM storage_namespace_management_operations o
+      WHERE o.id=OLD.management_operation_id AND o.state='APPLYING')
+      AND NOT EXISTS(SELECT 1 FROM storage_namespace_holds h WHERE h.profile_id=OLD.id AND h.state='HELD') INTO valid;
+  ELSIF OLD.state='APPLYING' AND NEW.state='ACTIVE' THEN
+    SELECT EXISTS(SELECT 1 FROM storage_namespace_management_operations o
+      WHERE o.id=OLD.management_operation_id AND o.profile_id=OLD.id AND o.state='COMPLETED'
+      AND o.target_generation=NEW.generation AND o.target_digest=NEW.digest) INTO valid;
+  END IF;
+  IF NOT valid THEN
+    RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Namespace profile transition';
+  END IF;
+  RETURN NEW;
+END $$;
+CREATE TRIGGER namespace_profile_guard BEFORE INSERT OR UPDATE OR DELETE ON storage_namespace_profiles
+  FOR EACH ROW EXECUTE FUNCTION guard_namespace_profile();
+CREATE TRIGGER namespace_profile_version_history BEFORE UPDATE OR DELETE ON storage_namespace_profile_versions
+  FOR EACH ROW EXECUTE FUNCTION reject_history_mutation();
+
+CREATE FUNCTION guard_namespace_hold() RETURNS trigger LANGUAGE plpgsql
+SET search_path = pg_catalog, durable_runtime, pg_temp AS $$
+DECLARE p storage_namespace_profiles;
+BEGIN
+  IF TG_OP='DELETE' THEN
+    RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Namespace hold history is retained';
+  END IF;
+  SELECT * INTO p FROM storage_namespace_profiles WHERE id=NEW.profile_id FOR UPDATE;
+  IF TG_OP='INSERT' THEN
+    IF p.id IS NULL OR p.state<>'ACTIVE' OR NEW.state<>'HELD' OR
+       ROW(p.generation,p.digest) IS DISTINCT FROM ROW(NEW.generation,NEW.digest) THEN
+      RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Namespace hold profile is not active';
+    END IF;
+  ELSIF ROW(NEW.id,NEW.profile_id,NEW.generation,NEW.digest,NEW.owner_token_hash,NEW.created_at)
+    IS DISTINCT FROM ROW(OLD.id,OLD.profile_id,OLD.generation,OLD.digest,OLD.owner_token_hash,OLD.created_at)
+    OR OLD.state<>'HELD' OR NEW.state<>'RELEASED' THEN
+    RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Namespace hold transition';
+  END IF;
+  RETURN NEW;
+END $$;
+CREATE TRIGGER namespace_hold_guard BEFORE INSERT OR UPDATE OR DELETE ON storage_namespace_holds
+  FOR EACH ROW EXECUTE FUNCTION guard_namespace_hold();
+
+CREATE FUNCTION guard_namespace_management() RETURNS trigger LANGUAGE plpgsql
+SET search_path = pg_catalog, durable_runtime, pg_temp AS $$
+DECLARE p storage_namespace_profiles;
+BEGIN
+  IF TG_OP='DELETE' THEN
+    RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Namespace management history is retained';
+  END IF;
+  SELECT * INTO p FROM storage_namespace_profiles WHERE id=NEW.profile_id FOR UPDATE;
+  IF TG_OP='INSERT' THEN
+    IF p.id IS NULL OR p.state<>'ACTIVE' OR NEW.state<>'DRAINING' OR
+       ROW(p.generation,p.digest) IS DISTINCT FROM ROW(NEW.generation,NEW.digest) THEN
+      RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Namespace management initial state';
+    END IF;
+  ELSE
+    IF ROW(NEW.id,NEW.profile_id,NEW.generation,NEW.digest,NEW.owner_token_hash,
+           NEW.target_generation,NEW.target_digest,NEW.created_at)
+       IS DISTINCT FROM ROW(OLD.id,OLD.profile_id,OLD.generation,OLD.digest,OLD.owner_token_hash,
+           OLD.target_generation,OLD.target_digest,OLD.created_at) OR
+       p.management_operation_id IS DISTINCT FROM NEW.id THEN
+      RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Namespace management identity';
+    END IF;
+    IF OLD.state='DRAINING' AND NEW.state='APPLYING' AND p.state='DRAINING' AND
+       NOT EXISTS(SELECT 1 FROM storage_namespace_holds h WHERE h.profile_id=p.id AND h.state='HELD') THEN
+      RETURN NEW;
+    ELSIF OLD.state='APPLYING' AND NEW.state='COMPLETED' AND p.state='APPLYING' AND
+          NEW.claimed_at=OLD.claimed_at THEN
+      RETURN NEW;
+    ELSE
+      RAISE EXCEPTION USING ERRCODE='23514', MESSAGE='Namespace management transition';
+    END IF;
+  END IF;
+  RETURN NEW;
+END $$;
+CREATE TRIGGER namespace_management_guard BEFORE INSERT OR UPDATE OR DELETE ON storage_namespace_management_operations
+  FOR EACH ROW EXECUTE FUNCTION guard_namespace_management();
diff --git a/src/main/durable-runtime/storage/namespace-holds.pg.test.mts b/src/main/durable-runtime/storage/namespace-holds.pg.test.mts
new file mode 100644
index 00000000..a4fbc761
--- /dev/null
+++ b/src/main/durable-runtime/storage/namespace-holds.pg.test.mts
@@ -0,0 +1,299 @@
+import assert from "node:assert/strict";
+import { createHash, randomUUID } from "node:crypto";
+import { test } from "node:test";
+import { setTimeout as pause } from "node:timers/promises";
+import type { Pool } from "pg";
+import { createDurablePool, DurableDatabaseError, withDurableTransaction } from "../db/connection.ts";
+import { applyMigrations, readMigrations } from "../db/migrate.ts";
+import { acquireNamespaceHold, beginNamespaceManagement, claimNamespaceManagement,
+  completeNamespaceManagement, readNamespaceHold, readNamespaceManagement,
+  registerNamespaceProfile, releaseNamespaceHold } from "./namespace-holds.ts";
+import type { NamespaceHoldInput, NamespaceManagementInput, NamespaceProfileInput,
+  NamespaceTransactionResult } from "./namespace-holds.ts";
+
+// Only the later Root dispatch supplies these existing isolated DB inputs.
+// This fixture does not create/reset/select a database or touch live NFS.
+const database = process.env.ORCA_NAMESPACE_HOLDS_DATABASE;
+const oid = process.env.ORCA_NAMESPACE_HOLDS_DATABASE_OID;
+const migrationsPath = process.env.ORCA_NAMESPACE_HOLDS_MIGRATIONS;
+if (process.env.ORCA_NAMESPACE_HOLDS_APPROVED !== "root-first-verification" ||
+    !database || !/^orca_[a-z0-9_]+$/.test(database) || database === "orca_dev" ||
+    process.env.PGDATABASE !== database || !oid || !/^[1-9][0-9]*$/.test(oid) || !migrationsPath) {
+  throw new Error("Root-approved existing isolated DB/OID and migrations required");
+}
+const pool = createDurablePool({ database, max: 6, application_name: "namespace-holds-first" });
+const hash = (value: string) => createHash("sha256").update(value).digest("hex");
+const deferred = () => {
+  let resolve!: () => void;
+  const promise = new Promise<void>(done => { resolve = done; });
+  return { promise, resolve };
+};
+function committed(result: NamespaceTransactionResult, status: string) {
+  assert.equal(result.database.ok, true);
+  assert.equal(result.database.settlement, "COMMITTED");
+  assert.equal(result.database.commitOutcome, "ACKNOWLEDGED");
+  assert.equal(result.disposition?.status, status);
+  assert.ok(Object.isFrozen(result));
+  assert.ok(Object.isFrozen(result.disposition));
+  return result.disposition!;
+}
+function failed(result: NamespaceTransactionResult, code: string) {
+  assert.equal(result.disposition, null);
+  assert.equal(result.database.ok, false);
+  if (result.database.ok) { throw new Error("Expected failure"); }
+  assert.equal(result.database.error.code, code);
+}
+async function identity() {
+  const value = (await pool.query<{ database: string; oid: string; system: string; backend_pid: number }>(
+    `SELECT current_database() AS database,
+      (SELECT oid::text FROM pg_database WHERE datname=current_database()) AS oid,
+      (SELECT system_identifier::text FROM pg_control_system()) AS system,pg_backend_pid() AS backend_pid`)).rows[0];
+  assert.equal(value.database, database);
+  assert.equal(value.oid, oid);
+  assert.equal(value.system, "7696101282789175327");
+  assert.deepEqual((await pool.query("SELECT dataset_name FROM durable_runtime.dataset_metadata")).rows,
+    [{ dataset_name: "orca-1012-dev-v1" }]);
+  return value;
+}
+// Existing affected rows are hashed privately, never printed as payloads.
+const originalTables = ["dataset_metadata", "storage_domains", "storage_bindings", "storage_write_grants",
+  "storage_mounts", "runtime_member_storage_bindings", "runtime_units", "attempts", "execution_grants",
+  "operations", "runtime_audit_events", "outbox_events"] as const;
+async function rowHashes() {
+  const result: Record<string, string[]> = {};
+  for (const table of originalTables) {
+    result[table] = (await pool.query<{ body: string }>(
+      `SELECT to_jsonb(t)::text AS body FROM durable_runtime.${table} t`)).rows.map(row => hash(row.body)).sort();
+  }
+  return result;
+}
+function retained(before: Record<string, string[]>, after: Record<string, string[]>) {
+  for (const table of originalTables) {
+    const counts = new Map<string, number>();
+    for (const item of after[table]) { counts.set(item, (counts.get(item) ?? 0) + 1); }
+    for (const item of before[table]) {
+      assert.ok((counts.get(item) ?? 0) > 0, `Original row missing in ${table}`);
+      counts.set(item, (counts.get(item) ?? 0) - 1);
+    }
+  }
+}
+const profile = (suffix: string): NamespaceProfileInput => ({
+  profileId: randomUUID(), datasetName: "orca-1012-dev-v1", backendId: "synthetic-namespace-backend",
+  exportId: `synthetic-namespace:${suffix}:${randomUUID()}`, generation: "0", digest: hash(`profile:${suffix}`),
+  actorId: "synthetic-namespace-management-actor"
+});
+const hold = (value: NamespaceProfileInput): NamespaceHoldInput => ({
+  ...value, pinId: randomUUID(), ownerToken: `synthetic-secret:${randomUUID()}`
+});
+const management = (value: NamespaceProfileInput): NamespaceManagementInput => ({
+  ...value, operationId: randomUUID(), ownerToken: `synthetic-secret:${randomUUID()}`,
+  targetGeneration: (BigInt(value.generation) + 1n).toString(), targetDigest: hash(`next:${randomUUID()}`)
+});
+async function history(id: string) {
+  return (await pool.query<{ audit: string; outbox: string }>(`SELECT
+    (SELECT count(*)::text FROM durable_runtime.runtime_audit_events WHERE next_state->>'profileId'=$1) AS audit,
+    (SELECT count(*)::text FROM durable_runtime.outbox_events WHERE aggregate_id=$1::uuid) AS outbox`, [id])).rows[0];
+}
+async function blocked(waiter: number, blocker: number) {
+  for (let attempt = 0; attempt < 100; attempt++) {
+    if ((await pool.query<{ blocked: boolean }>(
+      "SELECT $1::int=ANY(pg_blocking_pids($2::int)) AS blocked", [blocker, waiter])).rows[0].blocked) { return; }
+    await pause(50);
+  }
+  throw new DurableDatabaseError("NAMESPACE_FIXTURE_LOCK_WAIT_NOT_OBSERVED");
+}
+
+// Fixture-only wire decorator over actual PG clients. SQL bodies are unchanged.
+// The ACK fault hides an actual COMMIT response, then fails cleanup, without
+// claiming a production transport failure or fabricating an engine outcome.
+function wire(options: { gate?: ReturnType<typeof deferred>; entered?: ReturnType<typeof deferred>; started?: ReturnType<typeof deferred>;
+  rollback?: boolean; unknown?: boolean; pids: number[] }): Pool {
+  const connect = pool.connect.bind(pool);
+  return new Proxy(pool, { get(target, key, receiver) {
+    if (key !== "connect") { return Reflect.get(target, key, receiver); }
+    return async () => {
+      const client = await connect();
+      const query = client.query.bind(client);
+      options.pids.push((await query<{ pid: number }>("SELECT pg_backend_pid() AS pid")).rows[0].pid);
+      return new Proxy(client, { get(owner, method, originalReceiver) {
+        if (method === "release") { return client.release.bind(client); }
+        if (method !== "query") { return Reflect.get(owner, method, originalReceiver); }
+        return async (sql: string, values: unknown[] = []) => {
+          if (sql.includes("storage_domains") && sql.includes("FOR UPDATE")) { options.started?.resolve(); }
+          if (options.rollback && sql.startsWith("INSERT INTO durable_runtime.outbox_events")) {
+            throw new DurableDatabaseError("NAMESPACE_SYNTHETIC_ROLLBACK");
+          }
+          if (options.unknown && sql === "ROLLBACK") { throw new Error("synthetic cleanup response loss"); }
+          const result = await query(sql, values);
+          if (options.gate && sql.includes("storage_domains") && sql.includes("FOR UPDATE")) {
+            options.entered?.resolve();
+            await options.gate.promise;
+          }
+          if (options.unknown && sql === "COMMIT") { throw new Error("synthetic commit response loss"); }
+          return result;
+        };
+      } });
+    };
+  } });
+}
+
+await test("Namespace holds: first migration022 and focused durable management boundaries", async t => {
+  const gates: ReturnType<typeof deferred>[] = [];
+  t.after(async () => { for (const gate of gates) { gate.resolve(); } await pool.end(); });
+  const firstIdentity = await identity(); // Actual system/OID/dataset before DDL or seed.
+  const migrations = await readMigrations(migrationsPath);
+  assert.equal(migrations.length, 22);
+  assert.equal(migrations[21].version, "022-storage-namespace-holds.sql");
+  const ledgerBefore = (await pool.query("SELECT version,checksum,applied_at FROM durable_runtime.schema_migrations ORDER BY version")).rows;
+  assert.equal(ledgerBefore.length, 21, "First 022 run requires the existing ledger001–021");
+  assert.deepEqual(ledgerBefore.map(row => [row.version, row.checksum]),
+    migrations.slice(0, 21).map(row => [row.version, row.checksum]));
+  const originals = await rowHashes();
+  const absent = (await pool.query<{ absent: boolean }>(
+    "SELECT to_regclass('durable_runtime.storage_namespace_profiles') IS NULL AS absent")).rows[0].absent;
+  assert.equal(absent, true);
+  const applied = await applyMigrations(pool, migrations);
+  assert.equal(applied.length, 22);
+  assert.deepEqual(applied.slice(0, 21), ledgerBefore);
+  const seedIdentity = await identity();
+  const a = profile("acquire-first"), b = profile("drain-first"), c = profile("independent"), d = profile("rollback");
+  await withDurableTransaction(pool, async tx => {
+    for (const item of [a, b, c, d]) {
+      await tx.query("INSERT INTO durable_runtime.storage_domains(backend_id,export_id) VALUES($1,$2)", [item.backendId, item.exportId]);
+    }
+  });
+  for (const item of [a, b, c, d]) { committed(await registerNamespaceProfile(pool, item), "REGISTERED"); }
+  const pids: number[] = [];
+
+  // Acquire owns the domain lock first; drain must wait and then observe HELD.
+  const aHold = hold(a), aChange = management(a);
+  const acquiredGate = deferred(), acquiredEntered = deferred();
+  gates.push(acquiredGate);
+  const acquiringPids: number[] = [], drainingPids: number[] = [], drainingStarted = deferred();
+  const acquiring = acquireNamespaceHold(wire({ gate: acquiredGate, entered: acquiredEntered, pids: acquiringPids }), aHold);
+  await acquiredEntered.promise;
+  const draining = beginNamespaceManagement(wire({ started: drainingStarted, pids: drainingPids }), aChange);
+  await drainingStarted.promise;
+  await blocked(drainingPids[0], acquiringPids[0]);
+  // Another profile/domain proceeds while the first transaction is held.
+  const cHold = hold(c);
+  committed(await acquireNamespaceHold(pool, cHold), "ACQUIRED");
+  acquiredGate.resolve();
+  committed(await acquiring, "ACQUIRED");
+  committed(await draining, "WAITING");
+  pids.push(...acquiringPids, ...drainingPids);
+  committed(await claimNamespaceManagement(pool, aChange), "WAITING");
+  const beforeReplay = await history(a.profileId);
+  committed(await acquireNamespaceHold(pool, aHold), "ALREADY_HELD");
+  // Reconstructed caller retains only the durable ID/input, no memory owner map.
+  committed(await readNamespaceHold(pool, { ...aHold }), "ALREADY_HELD");
+  assert.deepEqual(await history(a.profileId), beforeReplay);
+  failed(await acquireNamespaceHold(pool, { ...aHold, ownerToken: `synthetic-secret:${randomUUID()}` }), "NAMESPACE_PIN_CONFLICT");
+  failed(await acquireNamespaceHold(pool, hold(a)), "NAMESPACE_PROFILE_NOT_ACTIVE");
+  const releaseGate = deferred(), releaseEntered = deferred(), claimStarted = deferred();
+  const releasePids: number[] = [], claimPids: number[] = [];
+  gates.push(releaseGate);
+  const releasing = releaseNamespaceHold(wire({ gate: releaseGate, entered: releaseEntered, pids: releasePids }), aHold);
+  await releaseEntered.promise;
+  const claiming = claimNamespaceManagement(wire({ started: claimStarted, pids: claimPids }), aChange);
+  await claimStarted.promise;
+  await blocked(claimPids[0], releasePids[0]);
+  releaseGate.resolve();
+  committed(await releasing, "RELEASED");
+  committed(await claiming, "EXECUTE");
+  pids.push(...releasePids, ...claimPids);
+  committed(await releaseNamespaceHold(pool, aHold), "ALREADY_RELEASED");
+  const beforeClaimReplay = await history(a.profileId);
+  committed(await claimNamespaceManagement(pool, { ...aChange }), "LOOKUP_REQUIRED");
+  committed(await readNamespaceManagement(pool, aChange), "LOOKUP_REQUIRED");
+  assert.deepEqual(await history(a.profileId), beforeClaimReplay);
+  const appliedResult = { status: "APPLIED", profileId: a.profileId, operationId: aChange.operationId,
+    generation: a.generation, targetGeneration: aChange.targetGeneration, targetDigest: aChange.targetDigest } as const;
+  const firstCompleted = committed(await completeNamespaceManagement(pool, aChange, appliedResult), "COMPLETED");
+  assert.equal(firstCompleted.generation, aChange.targetGeneration);
+  assert.equal(firstCompleted.digest, aChange.targetDigest);
+  const checkCompletedReplay = async () => {
+    for (const replay of [readNamespaceManagement, beginNamespaceManagement, claimNamespaceManagement]) {
+      const value = committed(await replay(pool, aChange), "ALREADY_COMPLETED");
+      assert.equal(value.generation, aChange.targetGeneration);
+      assert.equal(value.digest, aChange.targetDigest);
+    }
+    const value = committed(await completeNamespaceManagement(pool, aChange, appliedResult), "ALREADY_COMPLETED");
+    assert.equal(value.generation, aChange.targetGeneration);
+    assert.equal(value.digest, aChange.targetDigest);
+  };
+  await checkCompletedReplay();
+  committed(await readNamespaceHold(pool, aHold), "ALREADY_RELEASED");
+  failed(await acquireNamespaceHold(pool, hold(a)), "NAMESPACE_PROFILE_STALE");
+  const nextProfile = { ...a, generation: "1", digest: aChange.targetDigest }, nextHold = hold(nextProfile);
+  committed(await acquireNamespaceHold(pool, nextHold), "ACQUIRED");
+  committed(await releaseNamespaceHold(pool, nextHold), "RELEASED");
+  const nextChange = management(nextProfile);
+  committed(await beginNamespaceManagement(pool, nextChange), "READY_TO_CLAIM");
+  committed(await claimNamespaceManagement(pool, nextChange), "EXECUTE");
+  const secondCompleted = committed(await completeNamespaceManagement(pool, nextChange, {
+    status: "APPLIED", profileId: a.profileId, operationId: nextChange.operationId,
+    generation: nextProfile.generation, targetGeneration: nextChange.targetGeneration, targetDigest: nextChange.targetDigest
+  }), "COMPLETED");
+  assert.equal(secondCompleted.generation, "2");
+  await checkCompletedReplay(); // Original operation remains generation1, never current generation2.
+  committed(await readNamespaceHold(pool, aHold), "ALREADY_RELEASED");
+
+  // Drain owns the lock first; the new acquisition must fail without a row.
+  const bChange = management(b), bHold = hold(b), drainedGate = deferred(), drainedEntered = deferred();
+  gates.push(drainedGate);
+  const drainFirstPids: number[] = [], acquireSecondPids: number[] = [], acquireSecondStarted = deferred();
+  const drainFirst = beginNamespaceManagement(wire({ gate: drainedGate, entered: drainedEntered, pids: drainFirstPids }), bChange);
+  await drainedEntered.promise;
+  const acquireSecond = acquireNamespaceHold(wire({ started: acquireSecondStarted, pids: acquireSecondPids }), bHold);
+  await acquireSecondStarted.promise;
+  await blocked(acquireSecondPids[0], drainFirstPids[0]);
+  drainedGate.resolve();
+  committed(await drainFirst, "READY_TO_CLAIM");
+  failed(await acquireSecond, "NAMESPACE_PROFILE_NOT_ACTIVE");
+  pids.push(...drainFirstPids, ...acquireSecondPids);
+  assert.equal((await pool.query("SELECT id FROM durable_runtime.storage_namespace_holds WHERE id=$1", [bHold.pinId])).rowCount, 0);
+
+  // Actual PG rollback must retain no hold, audit or outbox from that call.
+  const dHold = hold(d), beforeRollback = await history(d.profileId);
+  const rolledBack = await acquireNamespaceHold(wire({ rollback: true, pids }), dHold);
+  failed(rolledBack, "NAMESPACE_SYNTHETIC_ROLLBACK");
+  assert.equal(rolledBack.database.settlement, "ROLLED_BACK");
+  assert.equal(rolledBack.database.commitOutcome, "NOT_ATTEMPTED");
+  assert.deepEqual(await history(d.profileId), beforeRollback);
+  failed(await readNamespaceHold(pool, dHold), "NAMESPACE_PIN_MISSING");
+
+  // Actual COMMIT occurs, but the synthetic wire loses ACK and cleanup reply.
+  const uncertain = await acquireNamespaceHold(wire({ unknown: true, pids }), dHold);
+  assert.equal(uncertain.disposition, null);
+  assert.equal(uncertain.database.ok, false);
+  assert.equal(uncertain.database.settlement, "UNCONFIRMED");
+  assert.equal(uncertain.database.commitOutcome, "UNKNOWN");
+  committed(await readNamespaceHold(pool, dHold), "ALREADY_HELD");
+  committed(await acquireNamespaceHold(pool, dHold), "ALREADY_HELD");
+  committed(await releaseNamespaceHold(pool, dHold), "RELEASED");
+  const dChange = management(d);
+  committed(await beginNamespaceManagement(pool, dChange), "READY_TO_CLAIM");
+  const uncertainClaim = await claimNamespaceManagement(wire({ unknown: true, pids }), dChange);
+  assert.equal(uncertainClaim.disposition, null);
+  assert.equal(uncertainClaim.database.commitOutcome, "UNKNOWN");
+  committed(await readNamespaceManagement(pool, dChange), "LOOKUP_REQUIRED");
+  committed(await claimNamespaceManagement(pool, dChange), "LOOKUP_REQUIRED");
+
+  const finalIdentity = await identity();
+  const ledgerAfter = (await pool.query("SELECT version,checksum,applied_at FROM durable_runtime.schema_migrations ORDER BY version")).rows;
+  assert.deepEqual(ledgerAfter, applied);
+  retained(originals, await rowHashes());
+  const summaries = (await pool.query<{ body: string }>(`SELECT next_state::text AS body
+    FROM durable_runtime.runtime_audit_events WHERE next_state->>'profileId'=ANY($1::text[])`,
+  [[a.profileId, b.profileId, c.profileId, d.profileId]])).rows;
+  for (const row of summaries) {
+    assert.equal(row.body.includes("ownerToken"), false);
+    assert.equal(row.body.includes("owner_token_hash"), false);
+    assert.equal(row.body.includes("synthetic-secret"), false);
+  }
+  t.diagnostic(JSON.stringify({ firstIdentity, seedIdentity, finalIdentity, backendPids: [...new Set(pids)],
+    ledgerBefore: ledgerBefore.length, ledgerAfter: ledgerAfter.length,
+    originalRowsRetained: true, physicalNamespacePinVerified: false, liveManagementMutation: false,
+    unknownFault: "synthetic ACK/cleanup loss over actual PG COMMIT", callbackCount: 1 }));
+});
diff --git a/src/main/durable-runtime/storage/namespace-holds.ts b/src/main/durable-runtime/storage/namespace-holds.ts
new file mode 100644
index 00000000..3fc71694
--- /dev/null
+++ b/src/main/durable-runtime/storage/namespace-holds.ts
@@ -0,0 +1,270 @@
+import { createHash, randomUUID } from "node:crypto";
+import type { Pool } from "pg";
+import { DurableDatabaseError, runDurableTransaction, type DurableTransaction,
+  type DurableTransactionResult } from "../db/connection.ts";
+import { lockAggregates } from "../db/locks.ts";
+import { appendAudit, enqueueOutbox } from "../journal/store.ts";
+import { counter, logicalId } from "../../../shared/durable-runtime/identity.ts";
+
+// Server-internal management coordination. No file-writer fence, directory
+// evidence issuer, public authentication boundary, or physical pin is supplied.
+export type NamespaceProfileInput = Readonly<{
+  profileId: string; datasetName: string; backendId: string; exportId: string;
+  generation: string; digest: string; actorId: string;
+}>;
+export type NamespaceHoldInput = NamespaceProfileInput & Readonly<{ pinId: string; ownerToken: string }>;
+export type NamespaceManagementInput = NamespaceProfileInput & Readonly<{
+  operationId: string; ownerToken: string; targetGeneration: string; targetDigest: string;
+}>;
+// The caller must already trust the management result. This DTO does not verify
+// external mutation completion and cannot be cast into directory evidence.
+export type TrustedNamespaceManagementResult = Readonly<{
+  status: "APPLIED"; profileId: string; operationId: string;
+  generation: string; targetGeneration: string; targetDigest: string;
+}>;
+export type NamespaceDisposition = Readonly<{
+  status: "REGISTERED" | "ALREADY_REGISTERED" | "ACQUIRED" | "ALREADY_HELD" |
+    "RELEASED" | "ALREADY_RELEASED" | "WAITING" | "READY_TO_CLAIM" |
+    "EXECUTE" | "LOOKUP_REQUIRED" | "COMPLETED" | "ALREADY_COMPLETED";
+  profileId: string; generation: string; digest: string;
+  pinId: string | null; operationId: string | null;
+}>;
+export type NamespaceTransactionResult = Readonly<{
+  database: DurableTransactionResult<NamespaceDisposition>;
+  disposition: NamespaceDisposition | null;
+}>;
+type ProfileRow = { id: string; dataset_name: string; backend_id: string; export_id: string;
+  generation: string; digest: string; state: string; management_operation_id: string | null; revision: string };
+type HoldRow = { id: string; profile_id: string; generation: string; digest: string;
+  owner_token_hash: string; state: string };
+type OperationRow = { id: string; profile_id: string; generation: string; digest: string;
+  owner_token_hash: string; target_generation: string; target_digest: string; state: string };
+
+function deny(code: string): never { throw new DurableDatabaseError(code); }
+function text(value: string): string {
+  if (typeof value !== "string" || !value || value.length > 512 || [...value].some(char => char.charCodeAt(0) < 32)) {
+    deny("NAMESPACE_INPUT_INVALID");
+  }
+  return value;
+}
+function digest(value: string): string {
+  if (typeof value !== "string" || !/^[0-9a-f]{64}$/.test(value)) { deny("NAMESPACE_DIGEST_INVALID"); }
+  return value;
+}
+function tokenHash(value: string): string {
+  if (typeof value !== "string" || value.length < 32 || value.length > 512 || [...value].some(char => char.charCodeAt(0) < 32)) {
+    deny("NAMESPACE_TOKEN_INVALID");
+  }
+  return createHash("sha256").update(value).digest("hex");
+}
+function capture(original: NamespaceProfileInput): NamespaceProfileInput {
+  return Object.freeze({ profileId: logicalId("storage-namespace-profile", original.profileId),
+    datasetName: text(original.datasetName), backendId: text(original.backendId), exportId: text(original.exportId),
+    generation: counter("namespace-generation", original.generation), digest: digest(original.digest),
+    actorId: text(original.actorId) });
+}
+function captureHold(original: NamespaceHoldInput) {
+  return Object.freeze({ ...capture(original), pinId: logicalId("storage-namespace-pin", original.pinId),
+    tokenHash: tokenHash(original.ownerToken) });
+}
+function captureManagement(original: NamespaceManagementInput) {
+  const input = Object.freeze({ ...capture(original),
+    operationId: logicalId("storage-namespace-operation", original.operationId), tokenHash: tokenHash(original.ownerToken),
+    targetGeneration: counter("namespace-generation", original.targetGeneration), targetDigest: digest(original.targetDigest) });
+  if (BigInt(input.targetGeneration) !== BigInt(input.generation) + 1n) { deny("NAMESPACE_GENERATION_INVALID"); }
+  return input;
+}
+function execute(pool: Pool, body: (tx: DurableTransaction) => Promise<NamespaceDisposition>): Promise<NamespaceTransactionResult> {
+  // Capture the borrowed receiver/method before the first await; never end it.
+  const connect = pool.connect;
+  const borrowed = new Proxy(pool, { get(target, key, receiver) {
+    return key === "connect" ? () => Reflect.apply(connect, pool, []) : Reflect.get(target, key, receiver);
+  } });
+  return runDurableTransaction(borrowed, body).then((database) =>
+    Object.freeze({ database, disposition: database.ok ? database.value : null }));
+}
+function disposition(input: NamespaceProfileInput, status: NamespaceDisposition["status"],
+  pinId: string | null = null, operationId: string | null = null): NamespaceDisposition {
+  return Object.freeze({ status, profileId: input.profileId, generation: input.generation,
+    digest: input.digest, pinId, operationId });
+}
+async function profile(tx: DurableTransaction, input: NamespaceProfileInput): Promise<ProfileRow> {
+  const query = tx.query.bind(tx);
+  await lockAggregates(tx, { storageDomains: [{ backendId: input.backendId, exportId: input.exportId }] });
+  const found = await query<ProfileRow>("SELECT * FROM durable_runtime.storage_namespace_profiles WHERE id=$1 FOR UPDATE", [input.profileId]);
+  const row = found.rows[0];
+  if (!row || row.dataset_name !== input.datasetName || row.backend_id !== input.backendId || row.export_id !== input.exportId) {
+    deny("NAMESPACE_PROFILE_SCOPE");
+  }
+  return row;
+}
+function exactVersion(row: ProfileRow, input: NamespaceProfileInput): void {
+  if (row.generation !== input.generation || row.digest !== input.digest) { deny("NAMESPACE_PROFILE_STALE"); }
+}
+function exactHold(row: HoldRow, input: ReturnType<typeof captureHold>): void {
+  if (row.profile_id !== input.profileId || row.generation !== input.generation || row.digest !== input.digest ||
+      row.owner_token_hash !== input.tokenHash) { deny("NAMESPACE_PIN_CONFLICT"); }
+}
+function exactOperation(row: OperationRow, input: ReturnType<typeof captureManagement>): void {
+  if (row.profile_id !== input.profileId || row.generation !== input.generation || row.digest !== input.digest ||
+      row.owner_token_hash !== input.tokenHash || row.target_generation !== input.targetGeneration || row.target_digest !== input.targetDigest) {
+    deny("NAMESPACE_OPERATION_CONFLICT");
+  }
+}
+async function held(tx: DurableTransaction, profileId: string): Promise<boolean> {
+  const found = await tx.query("SELECT id FROM durable_runtime.storage_namespace_holds WHERE profile_id=$1 AND state='HELD' LIMIT 1", [profileId]);
+  return found.rowCount === 1;
+}
+async function event(tx: DurableTransaction, input: NamespaceProfileInput, value: NamespaceDisposition): Promise<void> {
+  const row = await tx.query<{ revision: string }>("SELECT revision FROM durable_runtime.storage_namespace_profiles WHERE id=$1", [input.profileId]);
+  const payload = { kind: "STORAGE_NAMESPACE_TRANSITION", ...value };
+  const now = new Date();
+  const auditId = await appendAudit(tx, { actorId: input.actorId, kind: payload.kind, nextState: payload,
+    occurredAt: now, receivedAt: now, producerId: randomUUID(), producerSeq: counter("sequence:producer", "1"), evidenceRefs: [] });
+  await enqueueOutbox(tx, { eventId: logicalId("event", auditId), aggregateId: input.profileId,
+    aggregateKind: "storage-namespace-profile", revision: counter("row:storage-namespace-profile", row.rows[0].revision), event: payload });
+}
+async function changed(tx: DurableTransaction, input: NamespaceProfileInput, value: NamespaceDisposition): Promise<NamespaceDisposition> {
+  await event(tx, input, value);
+  return value;
+}
+
+export function registerNamespaceProfile(pool: Pool, original: NamespaceProfileInput): Promise<NamespaceTransactionResult> {
+  const input = capture(original);
+  return execute(pool, async (tx) => {
+    const query = tx.query.bind(tx);
+    await lockAggregates(tx, { storageDomains: [{ backendId: input.backendId, exportId: input.exportId }] });
+    const old = await query<ProfileRow>("SELECT * FROM durable_runtime.storage_namespace_profiles WHERE id=$1 FOR UPDATE", [input.profileId]);
+    if (old.rowCount) {
+      const row = old.rows[0];
+      if (row.dataset_name !== input.datasetName || row.backend_id !== input.backendId || row.export_id !== input.exportId) { deny("NAMESPACE_PROFILE_SCOPE"); }
+      exactVersion(row, input);
+      return disposition(input, "ALREADY_REGISTERED");
+    }
+    await query(`INSERT INTO durable_runtime.storage_namespace_profiles(id,dataset_name,backend_id,export_id,generation,digest,state)
+      VALUES($1,$2,$3,$4,$5,$6,'ACTIVE')`, [input.profileId, input.datasetName, input.backendId, input.exportId, input.generation, input.digest]);
+    await query("INSERT INTO durable_runtime.storage_namespace_profile_versions(profile_id,generation,digest) VALUES($1,$2,$3)", [input.profileId, input.generation, input.digest]);
+    return changed(tx, input, disposition(input, "REGISTERED"));
+  });
+}
+export function acquireNamespaceHold(pool: Pool, original: NamespaceHoldInput): Promise<NamespaceTransactionResult> {
+  const input = captureHold(original);
+  return execute(pool, async (tx) => {
+    const query = tx.query.bind(tx);
+    const row = await profile(tx, input);
+    const existing = await query<HoldRow>("SELECT * FROM durable_runtime.storage_namespace_holds WHERE id=$1", [input.pinId]);
+    if (existing.rowCount) {
+      exactHold(existing.rows[0], input);
+      return disposition(input, existing.rows[0].state === "HELD" ? "ALREADY_HELD" : "ALREADY_RELEASED", input.pinId);
+    }
+    exactVersion(row, input);
+    if (row.state !== "ACTIVE") { deny("NAMESPACE_PROFILE_NOT_ACTIVE"); }
+    await query(`INSERT INTO durable_runtime.storage_namespace_holds(id,profile_id,generation,digest,owner_token_hash,state)
+      VALUES($1,$2,$3,$4,$5,'HELD')`, [input.pinId, input.profileId, input.generation, input.digest, input.tokenHash]);
+    return changed(tx, input, disposition(input, "ACQUIRED", input.pinId));
+  });
+}
+export function readNamespaceHold(pool: Pool, original: NamespaceHoldInput): Promise<NamespaceTransactionResult> {
+  const input = captureHold(original);
+  return execute(pool, async (tx) => {
+    const query = tx.query.bind(tx);
+    await profile(tx, input);
+    const found = await query<HoldRow>("SELECT * FROM durable_runtime.storage_namespace_holds WHERE id=$1", [input.pinId]);
+    if (!found.rowCount) { deny("NAMESPACE_PIN_MISSING"); }
+    exactHold(found.rows[0], input);
+    return disposition(input, found.rows[0].state === "HELD" ? "ALREADY_HELD" : "ALREADY_RELEASED", input.pinId);
+  });
+}
+export function releaseNamespaceHold(pool: Pool, original: NamespaceHoldInput): Promise<NamespaceTransactionResult> {
+  const input = captureHold(original);
+  return execute(pool, async (tx) => {
+    const query = tx.query.bind(tx);
+    await profile(tx, input);
+    const found = await query<HoldRow>("SELECT * FROM durable_runtime.storage_namespace_holds WHERE id=$1", [input.pinId]);
+    if (!found.rowCount) { deny("NAMESPACE_PIN_MISSING"); }
+    exactHold(found.rows[0], input);
+    if (found.rows[0].state === "RELEASED") { return disposition(input, "ALREADY_RELEASED", input.pinId); }
+    await query("UPDATE durable_runtime.storage_namespace_holds SET state='RELEASED',released_at=clock_timestamp() WHERE id=$1", [input.pinId]);
+    return changed(tx, input, disposition(input, "RELEASED", input.pinId));
+  });
+}
+async function operation(tx: DurableTransaction, input: ReturnType<typeof captureManagement>): Promise<OperationRow> {
+  const found = await tx.query<OperationRow>("SELECT * FROM durable_runtime.storage_namespace_management_operations WHERE id=$1", [input.operationId]);
+  if (!found.rowCount) { deny("NAMESPACE_OPERATION_MISSING"); }
+  exactOperation(found.rows[0], input);
+  return found.rows[0];
+}
+function completed(input: NamespaceProfileInput, op: OperationRow): NamespaceDisposition {
+  return disposition({ ...input, generation: op.target_generation, digest: op.target_digest },
+    "ALREADY_COMPLETED", null, op.id);
+}
+export function readNamespaceManagement(pool: Pool, original: NamespaceManagementInput): Promise<NamespaceTransactionResult> {
+  const input = captureManagement(original);
+  return execute(pool, async (tx) => {
+    await profile(tx, input);
+    const op = await operation(tx, input);
+    if (op.state === "COMPLETED") { return completed(input, op); }
+    const status = op.state === "APPLYING" ? "LOOKUP_REQUIRED" : await held(tx, input.profileId) ? "WAITING" : "READY_TO_CLAIM";
+    return disposition(input, status, null, input.operationId);
+  });
+}
+export function beginNamespaceManagement(pool: Pool, original: NamespaceManagementInput): Promise<NamespaceTransactionResult> {
+  const input = captureManagement(original);
+  return execute(pool, async (tx) => {
+    const query = tx.query.bind(tx);
+    const row = await profile(tx, input);
+    const old = await query<OperationRow>("SELECT * FROM durable_runtime.storage_namespace_management_operations WHERE id=$1", [input.operationId]);
+    if (old.rowCount) {
+      exactOperation(old.rows[0], input);
+      if (old.rows[0].state === "COMPLETED") { return completed(input, old.rows[0]); }
+      const status = old.rows[0].state === "APPLYING" ? "LOOKUP_REQUIRED" : await held(tx, input.profileId) ? "WAITING" : "READY_TO_CLAIM";
+      return disposition(input, status, null, input.operationId);
+    }
+    exactVersion(row, input);
+    if (row.state !== "ACTIVE") { deny("NAMESPACE_PROFILE_NOT_ACTIVE"); }
+    await query(`INSERT INTO durable_runtime.storage_namespace_management_operations
+      (id,profile_id,generation,digest,owner_token_hash,target_generation,target_digest,state)
+      VALUES($1,$2,$3,$4,$5,$6,$7,'DRAINING')`, [input.operationId, input.profileId, input.generation, input.digest, input.tokenHash, input.targetGeneration, input.targetDigest]);
+    await query("UPDATE durable_runtime.storage_namespace_profiles SET state='DRAINING',management_operation_id=$2,revision=revision+1 WHERE id=$1", [input.profileId, input.operationId]);
+    return changed(tx, input, disposition(input, await held(tx, input.profileId) ? "WAITING" : "READY_TO_CLAIM", null, input.operationId));
+  });
+}
+export function claimNamespaceManagement(pool: Pool, original: NamespaceManagementInput): Promise<NamespaceTransactionResult> {
+  const input = captureManagement(original);
+  return execute(pool, async (tx) => {
+    const query = tx.query.bind(tx);
+    const row = await profile(tx, input);
+    const op = await operation(tx, input);
+    if (op.state === "COMPLETED") { return completed(input, op); }
+    if (op.state === "APPLYING") { return disposition(input, "LOOKUP_REQUIRED", null, input.operationId); }
+    exactVersion(row, input);
+    if (row.state !== "DRAINING" || row.management_operation_id !== input.operationId) { deny("NAMESPACE_OPERATION_CONFLICT"); }
+    if (await held(tx, input.profileId)) { return disposition(input, "WAITING", null, input.operationId); }
+    await query("UPDATE durable_runtime.storage_namespace_management_operations SET state='APPLYING',claimed_at=clock_timestamp() WHERE id=$1", [input.operationId]);
+    await query("UPDATE durable_runtime.storage_namespace_profiles SET state='APPLYING',revision=revision+1 WHERE id=$1", [input.profileId]);
+    return changed(tx, input, disposition(input, "EXECUTE", null, input.operationId));
+  });
+}
+export function completeNamespaceManagement(pool: Pool, original: NamespaceManagementInput,
+  originalResult: TrustedNamespaceManagementResult): Promise<NamespaceTransactionResult> {
+  const input = captureManagement(original);
+  const result = Object.freeze({ status: originalResult.status, profileId: originalResult.profileId,
+    operationId: originalResult.operationId, generation: originalResult.generation,
+    targetGeneration: originalResult.targetGeneration, targetDigest: originalResult.targetDigest });
+  if (result.status !== "APPLIED" || result.profileId !== input.profileId || result.operationId !== input.operationId ||
+      result.generation !== input.generation || result.targetGeneration !== input.targetGeneration || result.targetDigest !== input.targetDigest) {
+    deny("NAMESPACE_MANAGEMENT_RESULT_CONFLICT");
+  }
+  return execute(pool, async (tx) => {
+    const query = tx.query.bind(tx);
+    const row = await profile(tx, input);
+    const op = await operation(tx, input);
+    if (op.state === "COMPLETED") { return completed(input, op); }
+    exactVersion(row, input);
+    if (row.state !== "APPLYING" || op.state !== "APPLYING" || row.management_operation_id !== input.operationId) { deny("NAMESPACE_OPERATION_NOT_CLAIMED"); }
+    await query("UPDATE durable_runtime.storage_namespace_management_operations SET state='COMPLETED',completed_at=clock_timestamp() WHERE id=$1", [input.operationId]);
+    await query("INSERT INTO durable_runtime.storage_namespace_profile_versions(profile_id,generation,digest) VALUES($1,$2,$3)", [input.profileId, input.targetGeneration, input.targetDigest]);
+    await query("UPDATE durable_runtime.storage_namespace_profiles SET state='ACTIVE',management_operation_id=NULL,generation=$2,digest=$3,revision=revision+1 WHERE id=$1", [input.profileId, input.targetGeneration, input.targetDigest]);
+    return changed(tx, input, disposition({ ...input, generation: input.targetGeneration, digest: input.targetDigest }, "COMPLETED", null, input.operationId));
+  });
+}
